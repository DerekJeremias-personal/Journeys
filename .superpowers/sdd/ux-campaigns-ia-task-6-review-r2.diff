import { applyWizardSaveIdentity, resolveWizardCampaign } from "./campaign-live-edit";

describe("resolveWizardCampaign", () => {
  it("live with existing draft â†’ edit that draft id", async () => {
    const getCampaign = vi.fn(async () => ({
      success: true,
