## New: Backend.Model.UX/lib/journeys-seed.ts

export const JOURNEYS_SEED_STORAGE_KEY = "backend-model-ux-journeys-brief";
export const SEED_BRIEF_MAX_LENGTH = 32000;

function stripTrailingSlash(value: string): string {
  return value.trim().replace(/\/+$/, "");
}

export function parseAllowedSeedOrigins(raw: string | undefined): string[] {
  return (raw ?? "")
    .split(",")
    .map((o) => stripTrailingSlash(o))
    .filter(Boolean);
}

export function isAllowedSeedOrigin(origin: string, allowed: string[]): boolean {
  if (allowed.length === 0) return false;
  const normalized = stripTrailingSlash(origin);
  if (!normalized) return false;
  return allowed.some((item) => stripTrailingSlash(item) === normalized);
}

export function isSeedBriefTooLarge(brief: string): boolean {
  return brief.length > SEED_BRIEF_MAX_LENGTH;
}

export function readTenantIdFromSearch(search: string): string | null {
  const trimmed = new URLSearchParams(search).get("tenantId")?.trim() ?? "";
  return trimmed ? trimmed : null;
}

export function shouldSendJourneysSeed(args: {
  source: string | null;
  queryTenantId: string | null;
  tenantId: string;
}): boolean {
  if (args.source !== "journeys") return false;
  const queryTenant = args.queryTenantId?.trim();
  if (queryTenant && args.tenantId !== queryTenant) return false;
  return true;
}

export function takeJourneysSeedBrief(): string | null {
  const storage = globalThis.sessionStorage;
  if (typeof storage === "undefined") return null;
  const value = storage.getItem(JOURNEYS_SEED_STORAGE_KEY);
  storage.removeItem(JOURNEYS_SEED_STORAGE_KEY);
  return value && value.trim() ? value : null;
}

export function writeJourneysSeedBriefScript(brief: string, tenantId: string): string {
  const payload = JSON.stringify({ brief, tenantId });
  const safe = payload.replace(/</g, "\\u003c");
  return `<!DOCTYPE html><html><body><script>
(function(){
  var p = ${safe};
  try { sessionStorage.setItem(${JSON.stringify(JOURNEYS_SEED_STORAGE_KEY)}, p.brief); } catch (e) {}
  location.replace("/models/coach?tenantId=" + encodeURIComponent(p.tenantId) + "&source=journeys");
})();
</script></body></html>`;
}

