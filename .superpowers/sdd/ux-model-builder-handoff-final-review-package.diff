import { afterEach, describe, expect, it } from "vitest";
import {
  JOURNEYS_SEED_STORAGE_KEY,
  SEED_BRIEF_MAX_LENGTH,
  isAllowedSeedOrigin,
  isSeedBriefTooLarge,
  readTenantIdFromSearch,
  shouldSendJourneysSeed,
  takeJourneysSeedBrief,
  writeJourneysSeedBriefScript,
} from "./journeys-seed";

describe("shouldSendJourneysSeed", () => {
  it("returns false when source is not journeys", () => {
    expect(
      shouldSendJourneysSeed({
        source: "other",
        queryTenantId: "acme",
        tenantId: "acme",
      })
    ).toBe(false);
  });

  it("returns false when query tenant is present and context tenant differs", () => {
    expect(
      shouldSendJourneysSeed({
        source: "journeys",
        queryTenantId: "acme",
        tenantId: "mericantires",
      })
    ).toBe(false);
  });

  it("returns true when query tenant is present and context tenant matches", () => {
    expect(
      shouldSendJourneysSeed({
        source: "journeys",
        queryTenantId: "acme",
        tenantId: "acme",
      })
    ).toBe(true);
  });

  it("returns true when source is journeys and there is no query tenant", () => {
    expect(
      shouldSendJourneysSeed({
        source: "journeys",
        queryTenantId: null,
        tenantId: "mericantires",
      })
    ).toBe(true);
  });

  it("returns true when a padded query tenant matches a trimmed context tenant", () => {
    expect(
      shouldSendJourneysSeed({
        source: "journeys",
        queryTenantId: "  acme  ",
        tenantId: "acme",
      })
    ).toBe(true);
  });
});

describe("isAllowedSeedOrigin", () => {
  it("returns false when the allowlist is empty", () => {
    expect(isAllowedSeedOrigin("http://localhost:3000", [])).toBe(false);
  });

  it("returns false when the origin does not match", () => {
    expect(isAllowedSeedOrigin("https://evil.example", ["http://localhost:3000"])).toBe(false);
  });

  it("returns true when the origin matches after a trailing-slash strip", () => {
    expect(isAllowedSeedOrigin("http://localhost:3000/", ["http://localhost:3000"])).toBe(true);
  });
});

describe("isSeedBriefTooLarge", () => {
  it("returns false at the 32000 boundary and true above it", () => {
    expect(isSeedBriefTooLarge("x".repeat(SEED_BRIEF_MAX_LENGTH))).toBe(false);
    expect(isSeedBriefTooLarge("x".repeat(SEED_BRIEF_MAX_LENGTH + 1))).toBe(true);
  });
});

describe("readTenantIdFromSearch", () => {
  it("returns the trimmed tenant when ?tenantId= is present", () => {
    expect(readTenantIdFromSearch("?tenantId=acme")).toBe("acme");
    expect(readTenantIdFromSearch("?tenantId=  acme  ")).toBe("acme");
  });

  it("returns null when tenantId is empty or missing", () => {
    expect(readTenantIdFromSearch("?tenantId=")).toBeNull();
    expect(readTenantIdFromSearch("?tenantId=   ")).toBeNull();
    expect(readTenantIdFromSearch("")).toBeNull();
    expect(readTenantIdFromSearch("?foo=bar")).toBeNull();
  });
});

describe("writeJourneysSeedBriefScript", () => {
  it("does not put the brief in the redirect query", () => {
    const html = writeJourneysSeedBriefScript("Never use modelId \"unknown\".", "acme");
    expect(html).toContain("sessionStorage");
    expect(html).toContain("source=journeys");
    expect(html).toContain("tenantId=");
    expect(html).toContain("encodeURIComponent(p.tenantId)");
    expect(html).not.toMatch(/location\.replace\([^)]*unknown/);
  });

  it("escapes a brief that contains </script>", () => {
    const html = writeJourneysSeedBriefScript("</script>alert(1)", "acme");
    expect(html).not.toContain("</script>alert");
  });
});

describe("takeJourneysSeedBrief", () => {
  afterEach(() => {
    Reflect.deleteProperty(globalThis, "sessionStorage");
  });

  it("returns null when sessionStorage is missing", () => {
    expect(takeJourneysSeedBrief()).toBeNull();
  });

  it("reads and removes the stored brief once", () => {
    const store = new Map<string, string>();
    Object.defineProperty(globalThis, "sessionStorage", {
      configurable: true,
      value: {
        getItem(key: string) {
          return store.get(key) ?? null;
        },
        setItem(key: string, value: string) {
          store.set(key, value);
        },
        removeItem(key: string) {
          store.delete(key);
        },
      },
    });
    globalThis.sessionStorage.setItem(JOURNEYS_SEED_STORAGE_KEY, "  hello brief  ");
    expect(takeJourneysSeedBrief()).toBe("  hello brief  ");
    expect(store.has(JOURNEYS_SEED_STORAGE_KEY)).toBe(false);
    expect(takeJourneysSeedBrief()).toBeNull();
  });

  it("returns null for a blank stored brief", () => {
    const store = new Map<string, string>();
    Object.defineProperty(globalThis, "sessionStorage", {
      configurable: true,
      value: {
        getItem(key: string) {
          return store.get(key) ?? null;
        },
        removeItem(key: string) {
          store.delete(key);
        },
      },
    });
    store.set(JOURNEYS_SEED_STORAGE_KEY, "   ");
    expect(takeJourneysSeedBrief()).toBeNull();
    expect(store.has(JOURNEYS_SEED_STORAGE_KEY)).toBe(false);
  });
});

## New: Backend.Model.UX/app/api/model-builder/seed/route.ts

import { NextResponse } from "next/server";
import {
  isAllowedSeedOrigin,
  isSeedBriefTooLarge,
  parseAllowedSeedOrigins,
  writeJourneysSeedBriefScript,
} from "@/lib/journeys-seed";

export async function POST(request: Request) {
  const origin = request.headers.get("origin")?.replace(/\/+$/, "") ?? "";
  const allowedOrigins = parseAllowedSeedOrigins(process.env.MODEL_BUILDER_SEED_ORIGINS);
  if (!isAllowedSeedOrigin(origin, allowedOrigins)) {
    return NextResponse.json({ error: "forbidden" }, { status: 403 });
  }

  const form = await request.formData();
  const tenantId = String(form.get("tenantId") ?? "").trim();
  const brief = String(form.get("brief") ?? "").trim();
  const source = String(form.get("source") ?? "").trim();
  if (source !== "journeys" || !tenantId || !brief) {
    return NextResponse.json({ error: "tenantId, brief, and source=journeys are required" }, { status: 400 });
  }
  if (isSeedBriefTooLarge(brief)) {
    return NextResponse.json({ error: "brief too large" }, { status: 400 });
  }
  return new NextResponse(writeJourneysSeedBriefScript(brief, tenantId), {
    status: 200,
    headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" }
  });
}

